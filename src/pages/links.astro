---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const friends = (await getCollection("friends")).sort((a, b) =>
	a.data.name.localeCompare(b.data.name, "zh"),
);
---
<MainGridLayout title="友情链接" description="友情链接">
    <div class="card-base flex flex-col px-6 md:px-9 py-7 relative w-full rounded-[var(--radius-large)] overflow-hidden">
        <div class="flex flex-row items-baseline gap-3 mb-1.5">
            <h1 class="font-bold text-2xl text-black/90 dark:text-white/90">友情链接</h1>
        </div>
        <div class="text-sm text-black/50 dark:text-white/50 mb-5">想交换友链？欢迎联系我！</div>

        {friends.length === 0 ? (
            <div class="text-sm text-black/40 dark:text-white/40 py-8 text-center">暂无友链</div>
        ) : (
            <div class="flex flex-col gap-3">
                {friends.map((friend) => (
                    <a href={friend.data.url} target="_blank" rel="noopener"
                       class="btn-card !justify-start gap-4 rounded-xl w-full px-4 py-3 active:scale-[0.99]">
                        {friend.data.avatar && (
                            <div class="w-16 h-16 rounded-xl overflow-hidden shrink-0">
                                <ImageWrapper src={friend.data.avatar} alt={`${friend.data.name} 的头像`} />
                            </div>
                        )}
                        <div class="min-w-0 flex-1 text-left">
                            <div class="font-bold flex items-center gap-1 text-black/85 dark:text-white/85">
                                {friend.data.name}
                                <Icon name="fa6-solid:arrow-up-right-from-square"
                                      class="text-[0.875rem] text-black/[0.3] dark:text-white/[0.3]" />
                            </div>
                            {friend.data.description && (
                                <div class="text-sm text-black/50 dark:text-white/50 truncate">
                                    {friend.data.description}
                                </div>
                            )}
                        </div>
                    </a>
                ))}
            </div>
        )}
    </div>
</MainGridLayout>
