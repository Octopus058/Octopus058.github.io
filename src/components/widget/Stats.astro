---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { getCategoryList } from "../../utils/content-utils";
import WidgetLayout from "./WidgetLayout.astro";

/**
 * 侧边栏站点数据统计卡片：
 * 1. 站点已运行时间（实时跳动）
 * 2. 博客总览（文章 / 分类 / 最近更新）
 * 3. 访问统计（不蒜子 PV / UV）
 *
 * 运行计时起点沿用旧 Butterfly 配置 runtimeshow 的 publish_date。
 */
const START_TEXT = "2024/02/24 00:00:00"; // 改动此值即可调整计时起点

/**
 * 统计正文字数（近似 hexo-wordcount 口径）：
 * 每 1 个 CJK 字符计 1，其余按连续字母/数字的单词计 1。
 */
function countWords(raw: string): number {
    let s = raw.replace(/<[^>]+>/g, "");
    const reps: Record<string, string> = {
        "&ensp;": " ", "&nbsp;": " ", "&amp;": "&",
        "&#39;": "'", "&apos;": "'", "&quot;": '"',
        "&lt;": "<", "&gt;": ">",
    };
    for (const [a, b] of Object.entries(reps)) s = s.replaceAll(a, b);
    s = s.replace(/&#\d+;/g, " ");
    const cjk = s.match(/[㐀-䶿一-鿿぀-ヿ가-힯]/g);
    const noCjk = s.replace(/[㐀-䶿一-鿿぀-ヿ가-힯]/g, " ");
    const latin = noCjk.split(/[^0-9A-Za-zÀ-ɏ]+/).filter(Boolean).length;
    return (cjk ? cjk.length : 0) + latin;
}

const allPosts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
});
const postCount = allPosts.length;
const categoryCount = (await getCategoryList()).length;

let totalWords = 0;
let newest: Date | undefined;
for (const p of allPosts) {
    totalWords += countWords(p.body ?? "");
    if (!newest || p.data.published > newest) newest = p.data.published;
}
const totalWordsText = totalWords >= 1000
    ? `${(totalWords / 1000).toFixed(1)}k`
    : String(totalWords);

function pad(n: number) {
    return String(n).padStart(2, "0");
}
const lastUpdate = newest
    ? `${newest.getFullYear()}-${pad(newest.getMonth() + 1)}-${pad(newest.getDate())}`
    : "--";

/**
 * SSR 首屏占位值：不蒜子经典接口按域名(oct0pu5.cn)实时累计，这个计数器本身就包含老站
 * Butterfly 时期的数据——2026-09 实测 site_pv≈9751 / site_uv≈7240，正是"旧数据 9744/7235
 * + 迁移后的少量新增"，所以直接显示不蒜子返回值即可、无需再叠加任何基数(叠加会重复计数)。
 * 线上数值由官方 busuanzi 脚本实时覆盖；下面两个值仅作"脚本未返回/接口抽风"时防空白用，
 * 顺手改成最近一次读数即可。
 */
const PV_SEED = 9751; // 2026-09-04 oct0pu5.cn site_pv 读数(仅占位)
const UV_SEED = 7240; // 2026-09-04 oct0pu5.cn site_uv 读数(仅占位)

interface Props {
    class?: string;
    style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;

// 供服务端首屏渲染的初始文本（客户端脚本会接管并定时刷新）
function serverUptime(): string {
    const startMs = new Date(START_TEXT).getTime();
    let diff = Math.max(0, Date.now() - startMs);
    const yearMs = 365.2425 * 24 * 3600 * 1000;
    const years = Math.floor(diff / yearMs);
    diff -= years * yearMs;
    const days = Math.floor(diff / 86400000);
    return `${years} 年 ${days} 天`;
}
---

<WidgetLayout name="统计" id="stats" class={className} style={style}>
    <!-- 1. 站点已运行时间 -->
    <div class="px-1 pt-1 pb-3">
        <div class="rounded-lg bg-black/5 dark:bg-white/10 px-3 py-2.5 text-center mb-1">
            <div class="flex items-center justify-center gap-1.5 text-50 text-xs mb-1">
                <Icon name="material-symbols:schedule-outline-rounded" class="text-sm"></Icon>
                <span>站点已运行</span>
            </div>
            <div id="stats-uptime" class="font-bold text-[var(--primary)] text-sm leading-snug">{serverUptime()}</div>
        </div>
    </div>

    <!-- 2. 博客总览 -->
    <div class="px-4 pb-3 flex flex-col gap-1.5">
        <div class="flex items-center gap-1.5 text-50 text-xs mb-0.5">
            <Icon name="material-symbols:query-stats-rounded" class="text-sm"></Icon>
            <span>博客总览</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="text-50">文章</span>
            <span class="font-bold text-75">{postCount}</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="text-50">总字数</span>
            <span class="font-bold text-75" title={totalWordsText}>{totalWordsText}</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="text-50">分类</span>
            <span class="font-bold text-75">{categoryCount}</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="text-50">最近更新</span>
            <span class="font-bold text-75">{lastUpdate}</span>
        </div>
    </div>

    <div class="mx-4 border-dashed border-b-[1px] border-black/10 dark:border-white/[0.15]"></div>

    <!-- 3. 访问统计 -->
    <div class="px-4 pt-3 pb-4 flex flex-col gap-1.5">
        <div class="flex items-center gap-1.5 text-50 text-xs mb-0.5">
            <Icon name="material-symbols:visibility-outline-rounded" class="text-sm"></Icon>
            <span>访问统计</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="text-50">总访问量</span>
            <span id="busuanzi_value_site_pv" class="font-bold text-75">{PV_SEED}</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="text-50">访客数</span>
            <span id="busuanzi_value_site_uv" class="font-bold text-75">{UV_SEED}</span>
        </div>
    </div>
</WidgetLayout>

<script is:inline>
    // 访问统计: 加载官方 busuanzi 脚本。它按当前页面域名(oct0pu5.cn)实时计数,并把
    // site_pv / site_uv 写进 id 为 busuanzi_value_* 的元素(与上面两个 span 的 id 一致)。
    // 注意必须用普通(非 module)脚本方式注入——官方脚本是经典脚本,若被当成 module 加载,
    // 顶层的 var 声明不会挂到 window,计数会失效。
    // 若接口一直未返回,元素保持 SSR 占位值:不空白,也不显示"未知"。
    (function () {
        var s = document.createElement("script");
        s.src = "https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js";
        s.async = true;
        document.head.appendChild(s);
    })();
</script>

<script is:inline>
    // 站点运行时间（起点与服务端 START_TEXT 保持一致；只显示到"年 天"，每分钟刷新一次即可）
    (function () {
        const startMs = new Date("2024/02/24 00:00:00").getTime();
        const el = document.getElementById("stats-uptime");
        if (!el) return;
        const yearMs = 365.2425 * 24 * 3600 * 1000;
        function tick() {
            let diff = Math.max(0, Date.now() - startMs);
            const years = Math.floor(diff / yearMs);
            diff -= years * yearMs;
            const days = Math.floor(diff / 86400000);
            el.textContent = years + " 年 " + days + " 天";
        }
        tick();
        setInterval(tick, 60000);
    })();
</script>
